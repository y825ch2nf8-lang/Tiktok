# Kopiere diese Datei nach ".env" und trage deine Keys ein.
# NIEMALS die echte .env in Git einchecken (steht in .gitignore).

# --- LLM (Themen bewerten, Skripte, Captions) ---------------------------
# Standard: Anthropic (https://console.anthropic.com -> API Keys)
LLM_API_KEY=
# Optional: anderes Modell / anderer Anbieter
# LLM_PROVIDER=anthropic        # anthropic | openai
# LLM_MODEL=claude-sonnet-5-5
# LLM_BASE_URL=                 # nur fuer OpenAI-kompatible Endpunkte

# --- Voice-over ----------------------------------------------------------
# Standard "edge" braucht KEINEN Key. Fuer ElevenLabs (beste Qualitaet):
TTS_API_KEY=
# TTS_PROVIDER=edge             # edge | elevenlabs | openai | mock

# --- Visuals -------------------------------------------------------------
# Stock-Videos (kostenlos): https://www.pexels.com/api/
STOCK_API_KEY=
# KI-Bilder (OpenAI gpt-image-1) - optional:
IMAGE_API_KEY=
# KI-Video (noch kein Anbieter eingebaut, siehe README):
VIDEO_API_KEY=

# --- Trader-Tracker (python -m trader_tracker) ---
# Pflicht für SEC-Daten: dein Name + E-Mail (Vorgabe der SEC)
SEC_USER_AGENT="Max Mustermann max@example.com"

# --- Crypto-Tracker (python -m crypto_tracker) ---
# Optional: Alarme aufs Handy per Telegram (Bot über @BotFather anlegen, Chat-ID über @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
